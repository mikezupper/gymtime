# Production values. This file contains placeholders, not usable credentials.
APP_HOST=gymtime.example.com
APP_PUBLIC_URL=https://gymtime.example.com
APP_PORT=3000
INITIAL_ORGANIZER_EMAIL=organizer@example.com
AUTH_SECRET=replace-with-at-least-32-random-bytes
RESEND_BASE_URL=https://email-api.example.com
RESEND_API_KEY=replace-with-your-api-key
EMAIL_FROM=gymtime@example.com
TRUSTED_PROXY_CIDRS=172.20.0.0/16
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Optional native development overrides; pnpm dev reads these from its environment.
DEV_API_PORT=3017
DEV_WEB_PORT=5177
DEV_EMAIL_PORT=8027
DEV_DATABASE_URL=sqlite://.local/gymtime.db
